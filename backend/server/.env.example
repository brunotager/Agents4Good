# OpenRouter API Configuration
# Get your free key at https://openrouter.ai/keys (no credit card needed)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Agent Brain — tool calling, field matching, form updates, next question generation
OPENROUTER_MODEL_AGENT=nvidia/nemotron-3-super-120b-a12b:free

# Vision — image/document understanding (photos of medical records, SSA forms, etc.)
OPENROUTER_MODEL_VISION=google/gemma-4-31b-it:free
